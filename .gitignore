# Local secrets - never commit these
.env
.env.*
!.env.example

# Local, per-clone files generated/copied from framework/ - never commit
# these (see framework/README.md "Using it in a project"):
#   .agents/skills/  <- install-skills.sh's copy of framework/.agents/skills/
#   .claude/skills/  <- same copy, for the standalone Claude Code CLI
#   .codex/agents/   <- the Codex form of framework/.agents/agents/
/.agents/
/.claude/
.codex/agents/

# Python virtual environment and caches
.venv/
__pycache__/
.pytest_cache/

# Local coverage data (python -m coverage run)
.coverage
