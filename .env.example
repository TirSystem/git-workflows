# Copy to .env at the project root and fill in real values. .env is gitignored
# - never commit it (the project's .gitignore ignores .env and .env.*, and keeps
# .env.example).

# Gitea personal access token (Settings -> Applications -> Generate New Token),
# scoped to issues and milestones only. framework/scripts/sync-project.sh
# --apply uses it against a Gitea remote. The older names SYNC_TOKEN and
# GITEA_TOKEN still work as fallbacks.
# NOT a deploy key - deploy keys authenticate git-over-SSH only, not the API.
TOKEN_FOR_GITEA_ISSUES=

# Gitea personal access token with write access to the repository: push, pull
# requests and merge. Kept apart from TOKEN_FOR_GITEA_ISSUES so the sync needs
# nothing broader.
TOKEN_FOR_GITEA_REPO=
